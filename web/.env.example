VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8000

# Local dev proxy only. Do not prefix with VITE_; VITE_ variables are exposed
# to browser code. This value is read by vite.config.ts server-side.
AFL_PROXY_BEARER_TOKEN=

# Optional local dev proxy identity header when the backend requires Tailscale identity.
AFL_PROXY_TAILSCALE_USER_LOGIN=
AFL_PROXY_TAILSCALE_USER_HEADER=Tailscale-User-Login
